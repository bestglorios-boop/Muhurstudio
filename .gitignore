# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Hiçbir sır depoya girmez. `.env.example` yalnızca değersiz anahtar
# adları taşır ve bilerek tutulur; `.env.local` ASLA commitlenmez.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# yerel denetim / sunucu günlükleri (üretime girmez)
*.log
/lh-*.json

# yerel QA betiklerinin bıraktığı geçici çıktı / ekran görüntüleri
/audit/
/shots/
/qa-shots/
/lighthouse-report/
/*.err*
/*.out*
*.pid

# geçici onarım/üretim betikleri (kök düzey, tek kullanımlık)
/.*.mjs

